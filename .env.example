DATABASE_URL=postgresql://webadmin@localhost:5432/glotty
BETTER_AUTH_SECRET=your_32_character_secret_key_here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Model gateway (src/lib/ai). Cloudflare Workers AI: an API token with
# only the "Workers AI: Read" and "Workers AI: Edit" permissions is enough.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: map tiers to models ("<provider>:<model>[#none|low|medium|high]"). Defaults are in
# src/lib/ai/config.ts. Run `npm run ai:models` to see what is available.
# GLOTTY_MODEL_FAST=cloudflare:@cf/openai/gpt-oss-20b#low
# GLOTTY_MODEL_STRONG=cloudflare:@cf/moonshotai/kimi-k2.6#none

# Optional: any OpenAI-compatible provider, used with "openai-compat:<model>".
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=
