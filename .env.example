BETTER_AUTH_SECRET=your_32_character_secret_key_here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated emails that may use /annotate and /adjudicate. Unset in
# development: any signed-in account. Unset in production: nobody.
GLOTTY_ANNOTATOR_EMAILS=

# Model gateway (src/lib/ai). Cloudflare Workers AI: an API token with
# only the "Workers AI: Read" and "Workers AI: Edit" permissions is enough.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Required: map each tier to a model ("<provider>:<model>").
# There are no built-in defaults. Candidates are listed in src/lib/ai/config.ts;
# `npm run ai:models` shows what your account can use.
# Chosen from the 2026-10-19 screen against generator intent (not gold yet):
#   strong: fewest false accusations with no failed calls, p95 ~11s.
#   fast:   p95 ~5s and cheapest; least accurate, so a screen in front of strong.
#   Runner-up for strong: cloudflare:@cf/zai-org/glm-5.3#low (p95 ~50s).
GLOTTY_MODEL_FAST=cloudflare:@cf/openai/gpt-oss-20b
GLOTTY_MODEL_STRONG=cloudflare:@cf/moonshotai/kimi-k2.6

# Reasoning effort per tier (none|low|medium|high), sent as reasoning_effort.
# Its own variable because "#" starts a comment here, so a "#low" suffix on the
# model ref would be dropped. Leave unset for the provider default.
GLOTTY_EFFORT_FAST=low
GLOTTY_EFFORT_STRONG=none

# Governance layer (src/lib/governance): two judge models from different
# families that generate gold candidates and label them; gold is where they
# agree. Only used by offline scripts (gold:generate --governance, gold:label,
# gold:consensus), never on a learner request.
# Judge a: official OpenAI SDK, Responses API, store: false.
# OPENAI_API_KEY=
# GLOTTY_GOVERNANCE_MODEL=
# Optional: none|minimal|low|medium|high|xhigh. Unset means the model default.
# GLOTTY_GOVERNANCE_EFFORT=
# Judge b: official Google Gen AI SDK (Gemini API).
# GEMINI_API_KEY=
# GLOTTY_GOVERNANCE_MODEL_B=
# Optional: minimal|low|medium|high (thinking level). Unset means the model default.
# GLOTTY_GOVERNANCE_EFFORT_B=

# Optional: any OpenAI-compatible provider, used with "openai-compat:<model>".
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=
