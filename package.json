{
  "name": "glotty",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime false cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "tsx src/db/seed.ts",
    "ai:models": "tsx scripts/ai-models.ts",
    "ai:ping": "tsx scripts/ai-ping.ts",
    "gold:generate": "tsx scripts/gold-generate.ts",
    "gold:label": "tsx scripts/gold-label.ts",
    "gold:consensus": "tsx scripts/gold-consensus.ts",
    "gold:model-export": "tsx scripts/gold-model-export.ts",
    "gold:model-import": "tsx scripts/gold-model-import.ts",
    "gold:model-compare": "tsx scripts/gold-model-compare.ts",
    "anchor:import": "tsx scripts/anchor-import.ts",
    "train:export": "tsx scripts/train-export.ts",
    "train:codes": "tsx scripts/train-codes.ts",
    "train:build": "tsx scripts/train-build.ts",
    "taxonomy:review": "tsx scripts/taxonomy-review.ts",
    "taxonomy:draft": "tsx scripts/taxonomy-draft.ts",
    "errors:verify": "tsx scripts/errors-verify.ts",
    "morph:prep": "tsx scripts/morph-prep.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@opennextjs/cloudflare": "^1.20.12",
    "better-auth": "^1.7.11",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "openai": "^7.39.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.2"
  }
}
